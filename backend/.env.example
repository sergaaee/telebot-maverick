# Единый конфиг бэкенда (API для интерфейса), бэктеста, экспорта и Telegram-бота.
# Скопируйте в backend/.env и заполните. Параметры стратегии общие: бот торгует теми же значениями, что вы видите в интерфейсе.

# ---- Telegram (экспорт истории и бот; https://my.telegram.org -> API development tools) ----
TG_API_ID=
TG_API_HASH=
TG_SESSION=maverick            # файл сессии лежит в корне репозитория
TG_CHANNEL_ID=3217240841       # источник сигналов для бота и экспорта по умолчанию

# ---- Биржа для бота (ключи только для торговли; для бэктеста не нужны) ----
API_KEY=
API_SECRET=
API_PASSWORD=
DRY_RUN=true                   # true = бот только пишет в лог, ордера не отправляет

# ---- Данные (пути относительно папки backend/) ----
HISTORY_FILE=../history.csv
# Необязательно: файл с ликвидациями (например maverickBinance). Пусто = брать ликвидации из HISTORY_FILE
LIQ_FILE=../history_binance.csv
LIQ_MAX_AGE_H=3

# ---- Свечи ----
EXCHANGE=binanceusdm
SYMBOL=BTC/USDT:USDT
CANDLE_TF=1m
CACHE_DIR=../data
# Максимум баров, которые бэкенд отдаёт графику за один запрос
MAX_BARS=3000

# ---- Сервер ----
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Параметры стратегии по умолчанию (в интерфейсе их можно менять) ----
SIDE=both              # both | long | short
ONLY=                  # пусто | local | scalp  (торговать только по одной метрике)
LOCAL_MIN=1.85
SCALP_MIN=1.25
SHORT_LOCAL_MAX=0.7
SHORT_SCALP_MAX=1.2
CONFIRM=4              # сколько отчётов подряд нужно для сигнала
TP_PCT=6
SL_PCT=2
ORDER_SIZE=0.1         # BTC (и в бэктесте, и в боте)
FEE=0.0005             # taker-комиссия за сторону, доля
SLIPPAGE=0.0           # доля

# Фильтр «остывание/нагревание» (пусто = выключен): задайте COOL_DROP или COOL_DECLINES
COOL_METRIC=scalp      # scalp | local
COOL_DROP=
COOL_DECLINES=

# Фильтр «ликвидации закончились» (пусто = выключен): задайте LIQ_HOURS
LIQ_HOURS=
LIQ_FRAC=0.25
LIQ_PCT=0

# Пауза после стопа, ч (0 = выключена)
COOLDOWN_H=0
