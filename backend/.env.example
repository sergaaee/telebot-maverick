# Единый конфиг бэкенда (API для интерфейса), бэктеста, экспорта и Telegram-бота.
# Скопируйте в backend/.env и заполните. Параметры стратегии общие: бот торгует теми же значениями, что вы видите в интерфейсе.

# ---- Telegram (экспорт истории и бот; https://my.telegram.org -> API development tools) ----
TG_API_ID=
TG_API_HASH=
TG_SESSION=maverick            # файл сессии лежит в корне репозитория
TG_CHANNEL_ID=3217240841       # источник сигналов для бота и экспорта по умолчанию

# ---- Биржа для бота (ключи только для торговли; для бэктеста не нужны) ----
API_KEY=
API_SECRET=
API_PASSWORD=
DRY_RUN=true                   # true = бот только пишет в лог, ордера не отправляет

# ---- Источники метрик (файлы выгрузки истории; пути относительно папки backend/) ----
# Список источников; для каждого: SOURCE_<ID>_FILE и SOURCE_<ID>_LABEL. В интерфейсе источник выбирается в выпадающем списке.
SOURCES=coinbase,binance
SOURCE_DEFAULT=binance
SOURCE_COINBASE_LABEL=Coinbase Maverick
SOURCE_COINBASE_FILE=../history.csv
SOURCE_BINANCE_LABEL=Binance Maverick
SOURCE_BINANCE_FILE=../history_binance.csv
# Откуда брать ликвидации для фильтра «ликвидации закончились»: пусто = из самого источника, иначе id (например binance)
LIQ_SOURCE=
LIQ_MAX_AGE_H=3                # ликвидации из другого источника: макс. возраст записи, ч

# ---- Активы и свечи ----
EXCHANGE=binanceusdm
# Активы, между которыми переключается интерфейс (символы ccxt через запятую) и актив по умолчанию.
# Метрики Maverick общие для рынка; актив определяет, на каких свечах отрабатываются сигналы.
SYMBOLS=BTC/USDT:USDT
SYMBOL_DEFAULT=BTC/USDT:USDT
CANDLE_TF=1m
CACHE_DIR=../data
# Максимум баров, которые бэкенд отдаёт графику за один запрос
MAX_BARS=3000

# ---- Сервер ----
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Где хранится выбор в интерфейсе (источник, актив, параметры и ТФ по каждой связке)
STATE_FILE=../data/ui_state.json
# Активы, добавленные из интерфейса (кнопка «Добавить актив»); SYMBOLS выше остаются «постоянными»
ASSETS_FILE=../data/assets.json

# ---- Параметры стратегии по умолчанию (в интерфейсе их можно менять) ----
SIDE=both              # both | long | short
ONLY=                  # пусто | local | scalp | global  (торговать только по одной метрике)
LOCAL_MIN=1.85
SCALP_MIN=1.25
SHORT_LOCAL_MAX=0.7
SHORT_SCALP_MAX=1.2
# Deep Global (необязательно): лонг при Global >= GLOBAL_MIN, шорт при Global <= SHORT_GLOBAL_MAX; пусто — метрика не учитывается
GLOBAL_MIN=
SHORT_GLOBAL_MAX=
CONFIRM=4              # сколько отчётов подряд нужно для сигнала
# Тейк-профит. Один уровень: TP_PCT (расстояние от цены входа, %). Частями (1–3 уровня): TP_LEVELS="расстояние%:доля позиции%,..."
# например TP_LEVELS=3:50,6:30,10:20 — на +3% закрыть 50%, на +6% ещё 30%, на +10% остальные 20% (доли в сумме 100).
# Если TP_LEVELS задан, TP_PCT игнорируется. Бот пока поддерживает только один тейк на всю позицию.
TP_PCT=6
TP_LEVELS=
# true = после первого тейка стоп переносится в цену входа (безубыток); нужно минимум 2 тейка
BE_AFTER_TP1=false
SL_PCT=2
ORDER_SIZE=0.1         # BTC — размер позиции бота (в бэктесте/интерфейсе размер задают DEPOSIT, TRADE_PCT и LEVERAGE)
DEPOSIT=10000          # начальный депозит интерфейса/бэктеста, $
TRADE_PCT=10           # доля ТЕКУЩЕГО депозита в маржу сделки, %
LEVERAGE=1             # плечо: объём = маржа × плечо
PYRAMID_LEVERAGE=      # плечо доборов (пусто — как LEVERAGE)
LIQUIDATION_SIM=false  # true — моделировать ликвидацию: касание цены ликвидации ноги = потеря всей её маржи (метка LIQ)
MAINT_MARGIN_PCT=0.5   # поддерживающая маржа, % объёма (для цены ликвидации)
COMPOUND=true          # true — сложный процент (от текущего баланса), false — фиксированная сумма от начального депозита
FEE=0.0005             # taker-комиссия за сторону, доля
SLIPPAGE=0.0           # доля

# Фильтр «остывание/нагревание» (пусто = выключен): задайте COOL_DROP или COOL_DECLINES
COOL_METRIC=scalp      # scalp | local | global
COOL_DROP=
COOL_DECLINES=

# Фильтр «ликвидации закончились» (пусто = выключен): задайте LIQ_HOURS
LIQ_HOURS=
LIQ_FRAC=0.25
LIQ_PCT=0

# Пауза после стопа, ч (0 = выключена)
COOLDOWN_H=0

# ---- Топ-коины: сделки по монете из блока «Top Coin» отчёта в момент сигнала основной стратегии ----
# Свечи монеты качаются только на окно «момент сигнала + TOP_DAYS суток» (кнопка «Скачать свечи» на вкладке «Топ-коины»).
TOP_ENABLED=true
TOP_SIDES=long         # long | short | both — по сигналам какой стороны основной стратегии открывать сделку по монете
TOP_TP_PCT=5           # один тейк на 100% позиции, расстояние от входа, %
TOP_TP_LEVELS=         # или частями (1–3 уровня), как TP_LEVELS: 3:50,6:30,10:20 (если задан, TOP_TP_PCT игнорируется)
TOP_BE_AFTER_TP1=false # после первого тейка стоп переносится на цену входа (нужно минимум 2 тейка)
TOP_SL_PCT=3           # стоп-лосс, % от цены входа
TOP_SIZE_USD=100       # размер позиции, $
TOP_FEE=0.0005         # комиссия за сторону, доля
TOP_SLIPPAGE=0.0       # проскальзывание, доля
TOP_DAYS=3             # сколько суток держим сделку и качаем свечи (по истечении — закрытие по рынку, причина TIME)
TOP_MIN_VALUE=0        # пропускать сигналы, где значение топ-коина в отчёте ниже порога (0 = не фильтровать)

# ---- Фильтр тренда основного актива: лонг только выше всех выбранных EMA, шорт только ниже ----
TREND_ENABLED=false
TREND_EMAS=50,200      # любые из 20,50,100,200
TREND_TF=1h            # 5m | 15m | 30m | 1h | 4h | 1d — таймфрейм свечей для EMA

# ---- Автоподгрузка истории: сервер сам докачивает новые сообщения ботов из Telegram ----
# Включается, если заданы TG_API_ID и TG_API_HASH (и хотя бы раз выполнен `python cli.py export …`, чтобы сессия авторизовалась).
HISTORY_SYNC=              # false — выключить принудительно
HISTORY_SYNC_AT=2,32       # минуты часа (UTC), в которые идёт подгрузка: :02 и :32 — раз в полчаса, как боты публикуют отчёты; пусто — по периоду HISTORY_SYNC_MIN
HISTORY_SYNC_MIN=32        # период, минут (используется, только если HISTORY_SYNC_AT пусто); подгрузка идёт и сразу при запуске сервера
# Какой чат подгружать для каждого источника (id или имя). По умолчанию: coinbase -> TG_CHANNEL_ID, binance -> 2119980662
SOURCE_COINBASE_CHAT=
SOURCE_BINANCE_CHAT=

# ---- Автоподгрузка свечей: при запуске сервера и затем каждые CANDLES_SYNC_MIN минут (докачивается только хвост) ----
CANDLES_SYNC=true
CANDLES_SYNC_MIN=5
CANDLES_SYNC_SYMBOLS=      # какие активы обновлять (через запятую); пусто — все из SYMBOLS

# ---- Пользователи и вход на сайт ----
# Регистрации на сайте нет: пользователей создаёт администратор в консоли — python cli.py user add ЛОГИН (пароль спросит; см. python cli.py user -h).
# Данные рынка (свечи, история сообщений ботов) общие для всех; в базе лежит только то, что принадлежит пользователю
# (последние настройки интерфейса, привязка Telegram, конфиги бота сигналов).
AUTH_ENABLED=true      # false — вход выключен (только для локальной разработки!)
DB_FILE=../data/maverick.db
SESSION_DAYS=30
COOKIE_SECURE=false    # true — если сайт открыт по HTTPS
SIGNALBOT_USERNAME=    # @имя бота сигналов (показывается на сайте при привязке Telegram)

# ---- Пирамидинг, паузы между сигналами, «стоп не ставить, пока метрики сильны» (по умолчанию всё выключено — как раньше) ----
PYRAMID_ENABLED=false
PYRAMID_MAX=3          # максимум доборов в одну позицию
PYRAMID_PCT=5          # размер каждого добора, % депозита (первый вход берёт TRADE_PCT)
WEEKDAYS_ONLY=false     # true — входить только с открытия Токио в понедельник (00:00 UTC); открытая позиция закрывается к закрытию Нью-Йорка в пятницу (17:00 ET)
FRIDAY_CLOSE_BEFORE_MIN=0  # закрыть позицию в пятницу за столько минут до закрытия Нью-Йорка
PYRAMID_GAP_H=0        # минимум часов между доборами
PYRAMID_MOVE_PCT=0     # минимальное движение цены от последнего входа, % (0 — не проверять); работает вместе с паузой по времени
PYRAMID_MOVE_DIR=any   # any | favor | against — куда должна уйти цена: в любую сторону / в сторону позиции / против неё
PYRAMID_AVG=false      # true — доборы усредняют одну позицию (тейки и стоп от новой средней цены), false — каждый добор отдельной ногой
SIGNAL_GAP_H=0         # минимум часов между открытиями позиций (включая развороты)
SL_HOLD_STRONG=false   # SL не действует, пока метрики удовлетворяют условию входа (риск: убыток не ограничен, пока метрики сильны)

# --- торговля (автомод) ---
# Данные (свечи, отчёты) идут с Binance. Торговать можно на Hyperliquid. Счёт у КАЖДОГО пользователя свой: он присылает боту (/hl) адрес кошелька и ключ API-кошелька,
# бот проверяет их, удаляет сообщения из чата и хранит ключ в базе ЗАШИФРОВАННЫМ. Без подключённого счёта автомод — СИМУЛЯЦИЯ (ордера не отправляются).
TRADE_EXCHANGE=                 # пусто — по счетам пользователей; dry-run — принудительная симуляция для всех (аварийный выключатель)
SECRET_KEY=                     # мастер-ключ шифрования ключей бирж (Fernet). Пусто — создаётся файл secret.key рядом с базой (права 600). ПОТЕРЯЕТЕ — подключать счета придётся заново; храните копию отдельно от базы
TRADE_MAX_USD=5000              # предохранитель: максимальный объём одного ордера, $
TRADE_LOG_FILE=                 # лог всей автоторговли (JSON по строке); пусто — trading.log рядом с базой. Ротация 5 МБ × 5, секреты вырезаются
HL_SKIP_AGENT_CHECK=false       # true — не проверять через биржу, что присланный ключ принадлежит API-кошельку (только если Hyperliquid изменил ответ userRole и подключиться иначе нельзя)

# --- Кеш расчётов стратегий ---
# Снимки расчёта (входы, тренд, закрытые сделки) лежат в CACHE_DIR/runcache и в памяти: при новых отчётах/свечах считаются только новые данные.
# Один кеш на веб и бота. off — всегда считать с нуля (на случай подозрений на кеш).
RESULT_CACHE=on

# --- Безопасность автоторговли и отчёты ---
# Сторож бота: бот пишет пульс в базу; если он молчит, владельцам автомода приходит сообщение в Telegram.
# Работает в процессе backend, если задан SIGNALBOT_TOKEN (WATCHDOG=off — отключить), либо отдельно: python cli.py watchdog
WATCHDOG_DEAD_MIN=3             # нет пульса процесса бота дольше стольких минут — «бот не отвечает»
WATCHDOG_STALL_MIN=20           # циклы проверки не заканчиваются дольше — «бот завис» (первая загрузка свечей может идти долго)
DIGEST_HOUR_UTC=8               # во сколько (UTC) приходит сводка в Telegram: /digest daily|weekly|off в боте или на странице «Портфель»

# --- Фандинг в симуляции (во всех расчётах прибыли) ---
FUNDING_APR=0                   # % годовых; + лонг платит, шорт получает; 0 — не учитывать (например, 10.95 = 0.01% за 8 часов)
FUNDING_PERIOD_H=8              # период списания, часов: 1 / 2 / 4 / 8 / 12 / 24 (Binance — 8, Hyperliquid — 1)
FUNDING_MODE=signed             # signed — по знаку ставки; cost — платят обе стороны (консервативно)

# --- Вход лимитным ордером (вместо входа по рынку после подтверждённого сигнала) ---
ENTRY_LIMIT_PCT=0               # % движения цены от цены сигнала; 0 — по рынку
ENTRY_LIMIT_DIR=pullback        # pullback — на откат (лонг ниже, шорт выше); breakout — по ходу (лонг выше, шорт ниже)
ENTRY_LIMIT_TTL_H=4             # сколько часов ордер ждёт исполнения
