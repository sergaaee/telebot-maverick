# Конфигурация сервера. Скопируйте в .env (cp .env.server.example .env) и заполните.
# Этот файл читает и docker compose (DOMAIN, порты), и контейнеры backend/signalbot (всё остальное).
# Любую переменную из backend/.env.example и signalbot/.env.example можно добавить сюда.

# ---------- Домен и HTTPS ----------
# Домен, направленный A-записью на VPS. "_" — без домена (доступ по IP, только HTTP).
DOMAIN=_
# HTTPS включается автоматически, когда для DOMAIN выпущен сертификат (deploy/get-cert.sh). FORCE_HTTP=1 — не использовать сертификат.
FORCE_HTTP=0
# true — как только сайт открыт по HTTPS (cookie сессии получает флаг Secure). При доступе по http:// вход с true НЕ работает.
COOKIE_SECURE=false
# Порты на хосте
HTTP_PORT=80
HTTPS_PORT=443

# ---------- Вход на сайт ----------
AUTH_ENABLED=true
SESSION_DAYS=30
# @имя бота сигналов (без @) — подсказка на сайте при привязке Telegram
SIGNALBOT_USERNAME=

# ---------- Данные (внутри контейнера всё лежит в томе /app/data) ----------
CACHE_DIR=../data
DB_FILE=../data/maverick.db
ASSETS_FILE=../data/assets.json
STATE_FILE=../data/ui_state.json

# ---------- Источники метрик (файлы лежат в томе data; создаются командой export, см. DEPLOY.md) ----------
SOURCES=coinbase,binance
SOURCE_DEFAULT=binance
SOURCE_COINBASE_FILE=../data/history.csv
SOURCE_COINBASE_LABEL=Coinbase Maverick
SOURCE_COINBASE_CHAT=3217240841
SOURCE_BINANCE_FILE=../data/history_binance.csv
SOURCE_BINANCE_LABEL=Binance Maverick
SOURCE_BINANCE_CHAT=2119980662
LIQ_SOURCE=binance

# ---------- Биржа и активы ----------
EXCHANGE=binanceusdm
SYMBOLS=BTC/USDT:USDT
SYMBOL_DEFAULT=BTC/USDT:USDT
CANDLE_TF=1m
# Свечи подгружаются при запуске и каждые CANDLES_SYNC_MIN минут
CANDLES_SYNC=true
CANDLES_SYNC_MIN=5

# ---------- Telegram: подгрузка сообщений Maverick-ботов (аккаунт, не бот) ----------
# my.telegram.org -> API development tools. Сессия сохраняется в томе data (TG_SESSION=data/maverick -> /app/data/maverick.session).
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/maverick
TG_CHANNEL_ID=3217240841
# Подгружать новые сообщения при запуске и каждые HISTORY_SYNC_MIN минут (нужна авторизованная сессия — см. DEPLOY.md, шаг «История»)
HISTORY_SYNC=true
HISTORY_SYNC_MIN=32

# ---------- Бот сигналов ----------
# Токен от @BotFather. Пока пуст — бот ждёт и не падает.
SIGNALBOT_TOKEN=
# Историю уже подгружает backend (HISTORY_SYNC выше) — бот сам этого не делает, чтобы не конфликтовать за сессию Telegram
SIGNALBOT_SYNC=false
SIGNALBOT_POLL_SEC=60
SIGNALBOT_MAX_AGE_MIN=180
SIGNALBOT_LIVE_PRICE=true

# ---------- Стратегия по умолчанию (для новых пользователей; у каждого свои настройки сохраняются в интерфейсе) ----------
# Полный список — backend/.env.example (LOCAL_MIN, SCALP_MIN, CONFIRM, TP_LEVELS, SL_PCT, DEPOSIT, ...).

# ---------- Кеш расчётов (в томе data/results) ----------
RESULT_CACHE=true
