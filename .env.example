# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=maverick
TG_CHANNEL_ID=3217240841

# Биржа (id из ccxt: hyperliquid, bybit, binance, okx ...)
EXCHANGE=bybit
API_KEY=
API_SECRET=
# нужен только для некоторых бирж (okx, hyperliquid walletAddress и т.п.)
API_PASSWORD=
# Символ ccxt для USDT-перпа; для hyperliquid, например, BTC/USDC:USDC
SYMBOL=BTC/USDT:USDT
ORDER_SIZE=0.1

# % движения цены от входа
TP_PCT=3
SL_PCT=1

DEEP_LOCAL_MIN=1.65
DEEP_SCALP_MIN=2.0

# true = только логировать, ордера не отправлять
DRY_RUN=true
