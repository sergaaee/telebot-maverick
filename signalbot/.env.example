# Токен бота от @BotFather — ОБЯЗАТЕЛЬНО
SIGNALBOT_TOKEN=
# Пользователи и их конфиги лежат в SQLite-базе (DB_FILE в backend/.env, по умолчанию data/maverick.db) — общей с сайтом.
# Аккаунты создаёт администратор: python backend/cli.py user add ЛОГИН. Telegram привязывается к аккаунту кодом с сайта: /link КОД.
# Как часто проверять, пришли ли новые отчёты, секунд
SIGNALBOT_POLL_SEC=60
# Сигналы старше стольких минут не присылаются (например, после долгого простоя бота)
SIGNALBOT_MAX_AGE_MIN=180
# Подгружать новые сообщения Maverick-ботов из Telegram самим (нужны TG_API_ID/TG_API_HASH из backend/.env и авторизованная сессия).
# Если историю уже подгружает backend (HISTORY_SYNC), поставьте false, чтобы не делать это дважды.
SIGNALBOT_SYNC=
SIGNALBOT_SYNC_AT=2,32      # минуты часа (UTC), в которые бот подгружает сообщения: :02 и :32 (раз в полчаса); пусто — по периоду SIGNALBOT_SYNC_MIN
SIGNALBOT_SYNC_MIN=5        # период, минут (используется, только если SIGNALBOT_SYNC_AT пусто)
# Показывать уровни от текущей цены биржи (публичный запрос, ключи не нужны)
SIGNALBOT_LIVE_PRICE=true
# Сколько окон свечей топ-коинов докачивать за цикл для их статистики
SIGNALBOT_TOP_WINDOWS=10
# Сколько секунд за цикл тратить на докачку свечей топ-коинов (для их статистики); карточки и сигналы от этого не зависят
SIGNALBOT_TOP_BUDGET_SEC=60
